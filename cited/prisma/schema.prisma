// Cited — schéma de données
//
// Cible : PostgreSQL (Neon en production).
// Le modèle de tenant est `User` : un utilisateur possède ses marques.
// Toute table feuille porte `brandId` pour que le filtrage d'isolation
// ne dépende jamais d'une jointure transitive.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentification (NextAuth v5 + @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  plan             Plan      @default(FREE)
  stripeCustomerId String?   @unique
  stripeSubId      String?   @unique
  currentPeriodEnd DateTime?

  // Cycle de vie RGPD : la purge est calculable, pas implicite.
  cancelledAt    DateTime?
  purgeAt        DateTime?
  dataExportedAt DateTime?

  createdAt DateTime @default(now())

  accounts Account[]
  sessions Session[]
  brands   Brand[]
  usage    UsageCounter[]
  apiCalls ApiCall[]

  @@index([purgeAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domaine métier
// ---------------------------------------------------------------------------

model Brand {
  id          String    @id @default(cuid())
  userId      String
  name        String
  domain      String
  brandName   String
  /// Variantes du nom de marque, pour réduire les faux négatifs de détection.
  brandAliases String[] @default([])
  industry    String?
  country     String    @default("FR")
  language    String    @default("fr")
  frequency   Frequency @default(WEEKLY)
  isActive    Boolean   @default(true)
  /// Description factuelle de référence, utilisée pour détecter les hallucinations.
  groundTruth String?   @db.Text
  createdAt   DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitors Competitor[]
  prompts     Prompt[]
  campaigns   Campaign[]
  runs        Run[]
  citations   Citation[]

  // Permet les clés étrangères composites : une campagne ne peut pas
  // référencer une marque appartenant à un autre utilisateur.
  @@unique([id, userId])
  @@index([userId])
}

model Competitor {
  id        String   @id @default(cuid())
  brandId   String
  brandName String
  domain    String?
  createdAt DateTime @default(now())

  brand    Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  mentions CompetitorMention[]

  @@unique([id, brandId])
  @@index([brandId])
}

model Prompt {
  id       String       @id @default(cuid())
  brandId  String
  text     String       @db.Text
  family   PromptFamily
  /// Incrémenté à chaque édition du texte. Les Run figent la version utilisée.
  version  Int          @default(1)
  isActive Boolean      @default(true)
  /// Suppression logique : effacer un prompt ne doit jamais réécrire l'historique.
  deletedAt DateTime?
  createdAt DateTime    @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  runs  Run[]

  @@unique([id, brandId])
  @@index([brandId, isActive, deletedAt])
}

model Campaign {
  id      String @id @default(cuid())
  brandId String
  userId  String

  status CampaignStatus @default(QUEUED)

  /// Créneau planifié, arrondi. Porte l'idempotence : relancer la même
  /// campagne pour le même créneau ne crée pas de doublon.
  scheduledFor DateTime
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  /// Panier de moteurs figé à la création. Sans lui le dénominateur du score
  /// n'est pas reconstructible et le score devient manipulable.
  enginesUsed EngineId[]
  /// Nombre d'appels par (prompt x moteur). > 1 permet d'agréger le bruit.
  repetitions Int        @default(1)

  tasksTotal  Int @default(0)
  tasksDone   Int @default(0)
  tasksFailed Int @default(0)

  visibilityScore Float?
  shareOfVoice    Float?
  /// Demi-intervalle de confiance du score, en points. Sert à distinguer
  /// une vraie variation du bruit des moteurs.
  scoreMarginOfError Float?
  totalCostUsd       Float  @default(0)

  brand           Brand            @relation(fields: [brandId, userId], references: [id, userId], onDelete: Cascade)
  runs            Run[]
  recommendations Recommendation[]
  corrections     Correction[]

  @@unique([brandId, scheduledFor])
  @@unique([id, brandId])
  @@index([brandId, startedAt])
  @@index([status])
}

model Run {
  id         String @id @default(cuid())
  campaignId String
  promptId   String
  brandId    String

  engine EngineId
  /// Index de répétition pour un même (campagne, prompt, moteur).
  /// Plusieurs appels identiques mesurent la variance du moteur.
  repetition Int      @default(0)
  status     RunStatus @default(PENDING)

  /// Texte et version du prompt figés au moment de l'exécution : éditer ou
  /// supprimer un prompt ne réécrit pas les campagnes passées.
  promptText    String  @db.Text
  promptVersion Int     @default(1)
  /// Version exacte du modèle ayant répondu. Une rupture de courbe due à un
  /// changement côté fournisseur doit rester explicable.
  modelVersion  String?

  rawResponse    String?    @db.Text
  brandMentioned Boolean    @default(false)
  brandPosition  Int?
  sentiment      Sentiment?
  snippet        String?    @db.Text

  // Métriques d'évaluation RAG.
  claimsGenerated Int?
  claimsCorrect   Int?
  hallucinations  Boolean?
  positionScore   Float?
  entitySalience  Float?

  costUsd   Float   @default(0)
  latencyMs Int?
  /// Interne. Ne jamais exposer : révèle qu'un autre compte suit le même prompt.
  fromCache Boolean @default(false)

  // Exécution durable : bail, reprise et réessais.
  attempts      Int       @default(0)
  claimedAt     DateTime?
  leaseUntil    DateTime?
  nextAttemptAt DateTime?
  errorMessage  String?   @db.Text

  createdAt DateTime @default(now())

  campaign           Campaign            @relation(fields: [campaignId, brandId], references: [id, brandId], onDelete: Cascade)
  prompt             Prompt              @relation(fields: [promptId, brandId], references: [id, brandId], onDelete: Cascade)
  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  citations          Citation[]
  competitorMentions CompetitorMention[]

  @@unique([campaignId, promptId, engine, repetition])
  @@index([campaignId, status])
  @@index([brandId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
}

model Citation {
  id       String  @id @default(cuid())
  runId    String
  brandId  String
  url      String  @db.Text
  domain   String
  title    String?
  position Int

  run   Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Une reprise de campagne ne doit pas gonfler le décompte des sources.
  @@unique([runId, url])
  @@index([runId])
  @@index([brandId, domain])
}

model CompetitorMention {
  id           String @id @default(cuid())
  runId        String
  competitorId String
  brandId      String
  position     Int?

  run        Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  competitor Competitor @relation(fields: [competitorId, brandId], references: [id, brandId], onDelete: Cascade)

  @@unique([runId, competitorId])
  @@index([runId])
  @@index([competitorId])
}

model Recommendation {
  id         String   @id @default(cuid())
  campaignId String
  title      String
  finding    String   @db.Text
  action     String   @db.Text
  priority   Priority
  effort     Effort
  rank       Int

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Correction {
  id          String         @id @default(cuid())
  campaignId  String
  type        CorrectionType
  title       String
  targetUrl   String?        @db.Text
  targetQuery String?        @db.Text
  content     String         @db.Text
  priority    Priority
  applied     Boolean        @default(false)
  createdAt   DateTime       @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Cache, coûts et quotas
// ---------------------------------------------------------------------------

model EngineCache {
  id String @id @default(cuid())

  /// HMAC du texte normalisé, du moteur, de la version du modèle, du pays,
  /// de la langue et du seau temporel. Le secret empêche de calculer une
  /// empreinte hors ligne pour sonder le cache.
  fingerprint String @unique

  engine       EngineId
  modelVersion String
  country      String
  language     String
  family       PromptFamily?

  rawResponse String   @db.Text
  citations   Json
  costUsd     Float

  /// Marque à l'origine de l'entrée. Une marque ne doit jamais se voir servir
  /// sa propre réponse précédente : la courbe d'évolution deviendrait plate.
  sourceBrandId String?
  hitCount      Int     @default(0)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@index([engine, createdAt])
}

model ApiCall {
  id      String @id @default(cuid())
  userId  String?
  brandId String?
  runId   String?

  engine  EngineId
  purpose ApiPurpose

  costUsd   Float   @default(0)
  latencyMs Int?
  fromCache Boolean @default(false)
  success   Boolean @default(true)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([engine, createdAt])
}

model UsageCounter {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime

  /// Ce que le client achète et voit : le nombre de runs produits.
  runsUsed Int @default(0)
  /// Ce que la plateforme paie réellement, cache déduit. Sert la mesure de marge.
  billedCalls Int   @default(0)
  costUsd     Float @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([userId])
}

model AuditLead {
  id        String   @id @default(cuid())
  email     String
  domain    String
  brandName String
  score     Float?
  createdAt DateTime @default(now())

  @@unique([email, domain])
  @@index([createdAt])
}

model ProcessedWebhook {
  id          String   @id
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  STARTER
  PRO
  SCALE
}

enum Frequency {
  WEEKLY
  TWICE_WEEKLY
  DAILY
}

enum PromptFamily {
  PROBLEM
  SOLUTION
  COMPARISON
  DISCOVERY
  BRAND
}

enum CampaignStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum RunStatus {
  PENDING
  RUNNING
  RETRYING
  DONE
  FAILED
  UNPARSEABLE
}

enum EngineId {
  GROQ
  GEMINI
  CHATGPT
  PERPLEXITY
  GOOGLE_AIO
  CLAUDE
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Effort {
  LOW
  MEDIUM
  HIGH
}

enum CorrectionType {
  CONTENT
  SCHEMA
  LLMS_TXT
  BACKLINK
  LISTING
}

enum ApiPurpose {
  CAMPAIGN_QUERY
  BRAND_DETECTION
  PROMPT_GENERATION
  MENTION_ANALYSIS
  RECOMMENDATION
  CORRECTION
}
