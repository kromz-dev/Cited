generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentification (NextAuth v5 + @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  plan             String    @default("FREE")
  stripeCustomerId String?   @unique
  stripeSubId      String?   @unique
  currentPeriodEnd DateTime?

  // Cycle de vie RGPD : la purge est calculable, pas implicite.
  cancelledAt    DateTime?
  purgeAt        DateTime?
  dataExportedAt DateTime?

  createdAt DateTime @default(now())

  accounts       Account[]
  sessions       Session[]
  sites          Site[]
  monitoredSites MonitoredSite[]

  @@index([purgeAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domaine métier (V3 - Scanner et Pré-rendu)
// ---------------------------------------------------------------------------

model Site {
  id        String   @id @default(cuid())
  userId    String
  name      String
  domain    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages Page[]

  @@unique([id, userId])
  @@index([userId])
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  url       String
  path      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  botScans BotScan[]

  @@unique([siteId, path])
  @@index([siteId])
}

model BotScan {
  id        String    @id @default(cuid())
  pageId    String
  botName   String
  userAgent String
  status    String    @default("PENDING")
  scannedAt DateTime?
  createdAt DateTime  @default(now())

  page       Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  scanResult ScanResult?

  @@index([pageId])
}

model ScanResult {
  id          String   @id @default(cuid())
  botScanId   String   @unique
  statusCode  Int
  hasJsError  Boolean  @default(false)
  isHtmlEmpty Boolean  @default(false)
  rawHtml     String?
  createdAt   DateTime @default(now())

  botScan BotScan @relation(fields: [botScanId], references: [id], onDelete: Cascade)
}

/// Limitation de débit à fenêtre fixe. La base est la seule ressource
/// partagée entre instances en exécution sans serveur.
model RateLimit {
  id     String   @id @default(cuid())
  key    String
  window DateTime
  count  Int      @default(1)

  @@unique([key, window])
  @@index([window])
}

model AuditLead {
  id        String   @id @default(cuid())
  email     String
  domain    String
  brandName String
  score     Float?
  createdAt DateTime @default(now())

  @@unique([email, domain])
  @@index([createdAt])
}

model ProcessedWebhook {
  id          String   @id
  processedAt DateTime @default(now())
}

model MonitoredSite {
  id        String   @id @default(cuid())
  userId    String
  name      String
  url       String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanLogs ScanLog[]

  @@index([userId])
  @@index([status, createdAt])
}

model ScanLog {
  id         String   @id @default(cuid())
  siteId     String
  httpStatus Int
  payload    String?
  createdAt  DateTime @default(now())

  site MonitoredSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt(sort: Desc)])
}
